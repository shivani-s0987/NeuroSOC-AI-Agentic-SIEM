# Local development: sqlite:///./neurosoc.db
# Deployment: postgresql+psycopg://user:password@host:5432/neurosoc
APP_ENV=development
DATABASE_URL=sqlite:///./neurosoc.db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
AI_PROVIDER=fallback
# AI_API_KEY=replace-with-a-provider-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_RETRIES=1
AI_MAX_TOKENS=1800
AI_TEMPERATURE=0.2
AI_CONTEXT_MAX_EVENTS=50
AI_MAX_FIELD_CHARS=4000
AI_ENABLED=true
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
LOG_LEVEL=INFO
JWT_ISSUER=
JWT_AUDIENCE=
PASSWORD_RESET_EXPIRY_MINUTES=30
AUTH_RATE_LIMIT_PER_MINUTE=10
URLHAUS_ENABLED=true
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/
