# Local development: sqlite:///./neurosoc.db
# Deployment: postgresql+psycopg://user:password@host:5432/neurosoc
APP_ENV=development
DATABASE_URL=sqlite:///./neurosoc.db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
AI_PROVIDER=mock
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
LOG_LEVEL=INFO
