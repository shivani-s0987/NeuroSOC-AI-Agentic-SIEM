# Environment: development | testing | production
APP_ENV=development

# Development uses SQLite. Production must use PostgreSQL.
DATABASE_URL=sqlite:///./neurosoc.db
# PostgreSQL example: postgresql+psycopg://neurosoc:CHANGE_ME@localhost:5432/neurosoc
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-development-only-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-development-only-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
REFRESH_EXPIRY_DAYS=7
JWT_ISSUER=
JWT_AUDIENCE=

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
LOG_LEVEL=INFO

AI_ENABLED=true
AI_PROVIDER=fallback
# AI_API_KEY must remain server-side.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_RETRIES=1

CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
REDIS_URL=redis://localhost:6379/0
WORKER_MAX_ATTEMPTS=5
WORKER_POLL_SECONDS=2

UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Production Compose (secrets supplied out of band)
POSTGRES_DB=neurosoc
POSTGRES_USER=neurosoc
POSTGRES_PASSWORD=
